# Copy to .env.local. `lk app env --write --destination .env.local` fills the LiveKit values.

# LiveKit Cloud: the SIP trunk, the room and the hosted turn detector. No model runs on LiveKit
# Inference; the worker refuses to start without the OpenAI and Deepgram keys.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech recognition and backup voice. Required.
DEEPGRAM_API_KEY=
# TTS_VOICE=aura-2-arcas-en

# Select gemini after adding a Gemini API key; deepgram remains available for rollback.
# TTS_PROVIDER=deepgram
GOOGLE_API_KEY=
# GEMINI_TTS_MODELS=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Achird

# Language models, OpenAI only. Required. Defaults live in src/agent.py.
OPENAI_API_KEY=
# LLM_MODEL=openai/gpt-4.1-mini
# FALLBACK_LLM_MODEL=openai/gpt-4.1

# ntfy topic that receives on-call pages for urgent and emergency calls: the reason, a first name,
# the ZIP and the reference, never the caller's words or number. Unset skips the page.
NTFY_TOPIC=

# SQLite file for slots, bookings, tasks and call records. Defaults to data/summit-air.db.
# SUMMIT_AIR_DB=

# The inbound number, for reference. Twilio routes it to LiveKit over the SIP trunk.
SUMMIT_AIR_PHONE_NUMBER=

# Spend monitor (scripts/usage.py), all optional. Billing needs keys the agent itself never uses.
# OPENAI_ADMIN_KEY=        # sk-admin-..., platform.openai.com > Settings > Admin keys
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# DEEPGRAM_ADMIN_KEY=      # a key with billing:read (Owner or Admin role)
# USAGE_NTFY_TOPIC=        # defaults to NTFY_TOPIC

# Watchdog pages (scripts/watchdog.py), optional. Defaults to NTFY_TOPIC.
# WATCHDOG_NTFY_TOPIC=

# Dispatch push (src/record.py): one line per finished call, at default priority, with no caller
# words, number or street. Optional; defaults to NTFY_TOPIC. `scripts/calls.py <ref>` has the rest.
# DISPATCH_NTFY_TOPIC=
