# Copy to .env.local. `lk app env --write --destination .env.local` fills the LiveKit values.

# LiveKit Cloud (also authenticates LiveKit Inference for STT, LLM and TTS)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Model IDs, pinned after test calls. Defaults live in src/agent.py.
# STT_MODEL=assemblyai/universal-3-5-pro
# LLM_MODEL=google/gemma-4-31b-it
# TTS_MODEL=inworld/inworld-tts-2-flash
# TTS_VOICE=Ashley

# Telephony (Twilio SIP trunk into LiveKit)
SUMMIT_AIR_PHONE_NUMBER=
DISPATCH_TRANSFER_NUMBER=

# Booking store (Supabase Postgres)
DATABASE_URL=
