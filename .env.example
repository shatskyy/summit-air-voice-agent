# Copy to .env.local. `lk app env --write --destination .env.local` fills the LiveKit values.

# LiveKit Cloud: the SIP trunk, the room, and LiveKit Inference for the language model
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech to text and text to speech. Without a key, speech falls back to LiveKit Inference.
DEEPGRAM_API_KEY=
# TTS_VOICE=aura-2-thalia-en

# Language models, chosen by tests/test_agent.py. Defaults live in src/agent.py.
# LLM_MODEL=google/gemma-4-31b-it
# FALLBACK_LLM_MODEL=openai/gpt-4.1-mini

# ntfy topic that receives on-call pages for urgent and emergency calls. Unset skips the page.
NTFY_TOPIC=

# SQLite file for slots, bookings, tasks and call records. Defaults to data/summit-air.db.
# SUMMIT_AIR_DB=

# The inbound number, for reference. Twilio routes it to LiveKit over the SIP trunk.
SUMMIT_AIR_PHONE_NUMBER=
